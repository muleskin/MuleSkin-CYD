# Web Push for MuleSkin's ntfy -- copy to .env beside docker-compose.yml on the
# server (NOT into the repo: the private key is a secret) and fill in:
#
#   sudo docker exec muleskin-ntfy ntfy webpush keys
#
# prints a public and a private key. The email address goes to Apple/Google
# with each push as the sender's contact, as the Web Push standard requires.
NTFY_WEB_PUSH_PUBLIC_KEY=
NTFY_WEB_PUSH_PRIVATE_KEY=
NTFY_WEB_PUSH_EMAIL_ADDRESS=
