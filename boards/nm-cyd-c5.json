  },
  "frameworks": [
    "arduino"
  ],
  "name": "RockBase NM-CYD-C5 (ESP32-C5)",
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 327680,
    "maximum_size": 16777216,
    "require_upload_port": true,
    "speed": 460800
  },
  "url": "https://github.com/RockBase-iot/NM-CYD-C5",
  "vendor": "RockBase IoT"
}
